package locale

// Presentation-only strings. Language never changes simulation or save identity.
Language :: enum { English, Russian }
Key :: enum {
 Continue, New_Game, Settings, Quit, Resume, Quick_Save, Quick_Load, Intro,
 Paused, Premise, Cold_Boot, Difficulty, Begin, Back, New_Note,
 Settings_Hint, Mouse, Invert, Effects, Voice, Ambience, Music, Display, Browser, Borderless, Window, Window_Size, Resolution, Controls,
 On, Off, Controls_Hint, Press_Key, Reset_Controls, Navigation, Escape_Back,
 Forward, Backward, Left, Right, Jump, Dash, Fire, Scope, Use, Kick, Repeater, Fragmentator, Shotgun, Shells,
 Choose, Duke, Lora, Duke_Line, Lora_Line, Select_Hint, Select_Back, Play, Next, Skip,
 Scene_0, Scene_1, Scene_2, Missing, Missing_Line, Ransom_0, Ransom_1, Ransom_Signature,
 Health, Unlimited, Charges, Hostiles, Muted, Grounded, Airborne, Gliding, Updraft,
 Wing_Hint_Title, Wing_Hint_Line,
 Secret, Anvil, Pacifier, Frog, Not_Here, Complete, End_Line, End_Menu,
 Death_Title, Death_Line, Death_Killer, Death_Retry, Death_Wait, Death_Frog,
 Killer_Unknown, Killer_Fairy, Killer_Hunter, Killer_Crab, Killer_Kettle, Killer_GC, Killer_Fragment, Killer_Void, Killer_Anvil, Killer_Nanny, Killer_Rabbit,
}

